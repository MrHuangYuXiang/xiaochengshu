# 运行环境: 填写development/production
ENV={{BACKEND_ENV}}

# 数据库相关配置
DB_HOST={{BACKEND_DB_HOST}}
DB_PORT={{BACKEND_DB_PORT}}
DB_USER={{BACKEND_DB_USER}}
DB_PASSWORD={{BACKEND_DB_PASSWORD}}
DB_DATABASE={{BACKEND_DB_DATABASE}}

# 文件相关配置

# 文件上传目录
UPLOAD_DIR={{BACKEND_UPLOAD_DIR}}
# 图片文件大小上限(单位mb,下同)
MAX_IMAGE_FILE_SIZE={{BACKEND_MAX_IMAGE_FILE_SIZE}}
# 视频文件大小上限
MAX_VIDEO_FILE_SIZE={{BACKEND_MAX_VIDEO_FILE_SIZE}}
# json文件大小上限
MAX_JSON_FILE_SIZE={{BACKEND_MAX_JSON_FILE_SIZE}}

# 长连接相关配置
PERSISTENT_HEARTBEAT_INTERVAL={{BACKEND_PERSISTENT_HEARTBEAT_INTERVAL}}

#jwt相关配置
JWT_SECRET={{BACKEND_JWT_SECRET}}
